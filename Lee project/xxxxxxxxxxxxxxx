 <style>
  /* Language switcher */
  .lang-switch{position:relative;}
  .lang-btn{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:9px 14px;color:var(--text);cursor:pointer;display:flex;align-items:center;gap:6px;font-family:'DM Sans',sans-serif;font-size:13px;transition:border-color 0.2s;}
  .lang-btn:hover{border-color:var(--accent);color:var(--accent);}
  .lang-menu{display:none;position:absolute;top:calc(100% + 8px);right:0;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:6px;min-width:170px;box-shadow:0 20px 40px rgba(0,0,0,0.5);z-index:150;}
  .lang-menu.open{display:block;}
  .lang-option{display:flex;align-items:center;gap:10px;width:100%;background:none;border:none;border-radius:8px;padding:10px 12px;color:var(--text);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px;text-align:left;transition:background 0.15s;}
  .lang-option:hover{background:rgba(0,212,255,0.1);}
  .lang-option.active{color:var(--accent);background:rgba(0,212,255,0.08);}
  .lang-flag{font-size:16px;}


</style>
</head>
<body>



  
    <div class="nav-actions">
      <div class="lang-switch">
        <button class="lang-btn" id="lang-btn" onclick="toggleLangMenu(event)">
          <span id="lang-flag-current">🌐</span> <span id="lang-label-current">Language</span> ▾
        </button>
         <div class="language-container">
    <button class="lang-btn" id="lang-btn" onclick="toggleLangMenu(event)">
      <span id="lang-flag-current">🌐</span>
      <span id="lang-label-current">Language</span>
      <span class="arrow">▾</span>
    </button>

    <div class="lang-menu" id="lang-menu">
      <button class="lang-option" onclick="setLanguage('en')">
        <span class="lang-flag">🇬🇧</span>
        <span>English</span>
      </button>
      <button class="lang-option" onclick="setLanguage('fr')">
        <span class="lang-flag">🇫🇷</span>
        <span>Français</span>
      </button>
      <button class="lang-option" onclick="setLanguage('rw')">
        <span class="lang-flag">🇷🇼</span>
        <span>Ikinyarwanda</span>
      </button>
    </div>
  </div>

  <script>
    const LANGUAGES = {
      en: { flag: "🇬🇧", label: "English" },
      fr: { flag: "🇫🇷", label: "Français" },
      rw: { flag: "🇷🇼", label: "Ikinyarwanda" }
    };

    function toggleLangMenu(event) {
      event.stopPropagation();
      document.getElementById("lang-menu").classList.toggle("show");
    }

    function setLanguage(lang) {
      const { flag, label } = LANGUAGES[lang];
      document.getElementById("lang-flag-current").textContent = flag;
      document.getElementById("lang-label-current").textContent = label;
      document.getElementById("lang-menu").classList.remove("show");
    }

    document.addEventListener("click", () => {
      document.getElementById("lang-menu").classList.remove("show");
    });
  </script>
        





